# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BRIDGE_TOKEN=replace-with-a-random-43-character-token

# Windows Docker Desktop examples. Use /home/you/.claude and /home/you/.codex on Linux.
CLAUDE_CONFIG_DIR_HOST=C:/Users/your-name/.claude
CODEX_HOME_HOST=C:/Users/your-name/.codex

# Keep these ports in sync when changing the default.
BRIDGE_PORT=8765
BRIDGE_MOBILE_URL=ws://10.0.2.2:8765
BRIDGE_ENABLE_CLAUDE=true
BRIDGE_ENABLE_CODEX=true
CODEX_VERSION=0.146.0

# Optional provider-side project filters. Leave empty to show all local sessions.
BRIDGE_CLAUDE_PROJECT_DIR=
BRIDGE_CODEX_CWD=

# Allow sending new messages into existing sessions from the phone.
# The container mounts provider data read-only, so this stays off by default.
BRIDGE_ALLOW_TURNS=false
